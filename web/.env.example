# Privy app credentials — get these from https://dashboard.privy.io
# Public app ID is exposed to the browser (required for the React SDK)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# App secret stays server-only — used for verifying access tokens or calling Privy's server API
# Never prefix with NEXT_PUBLIC_
PRIVY_APP_SECRET=your_privy_app_secret_here

# Helius RPC URL — server-only. The browser hits /api/rpc and the proxy forwards to this.
# Keeping this off NEXT_PUBLIC_ prevents the API key from shipping to the browser.
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=your_helius_api_key_here

# Public devnet WebSocket for Solana subscriptions. Safe to expose (no API key).
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com
