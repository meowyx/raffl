# Privy app credentials — get these from https://dashboard.privy.io
# Public app ID is exposed to the browser (required for the React SDK)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# App secret stays server-only
PRIVY_APP_SECRET=your_privy_app_secret_here

# Helius RPC URL
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=your_helius_api_key_here

# WebSocket endpoint for Solana subscriptions

NEXT_PUBLIC_SOLANA_WS_URL=wss://devnet.helius-rpc.com/?api-key=your_helius_api_key_here
